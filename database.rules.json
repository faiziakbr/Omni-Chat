{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name', 'email'])",
        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
        "email": { ".validate": "newData.isString() && newData.val() === auth.token.email.toLowerCase()" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },
    "emailIndex": {
      "$key": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.val() === auth.uid) && (!newData.exists() || newData.val() === auth.uid)"
      }
    },
    "userChats": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$peerUid": {
          ".write": "auth != null && (auth.uid === $uid || auth.uid === $peerUid)"
        }
      }
    },
    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "inbox": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$msgId": {
          ".write": "auth != null && ((!newData.exists() && auth.uid === $uid) || (!data.exists() && newData.child('senderId').val() === auth.uid))",
          ".validate": "!newData.exists() || newData.hasChildren(['id', 'chatId', 'senderId', 'text', 'sentAt'])",
          "id": { ".validate": "newData.val() === $msgId" },
          "text": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 4000" }
        }
      }
    },
    "receipts": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$msgId": {
          ".write": "auth != null && ((!newData.exists() && auth.uid === $uid) || newData.child('by').val() === auth.uid)",
          ".validate": "!newData.exists() || (newData.hasChildren(['status', 'by', 'at']) && newData.child('status').val().matches(/^(delivered|read)$/))"
        }
      }
    },
    "calls": {
      "$callId": {
        ".read": "auth != null && (data.child('callerId').val() === auth.uid || data.child('calleeId').val() === auth.uid)",
        ".write": "auth != null && (data.child('callerId').val() === auth.uid || data.child('calleeId').val() === auth.uid || (!data.exists() && newData.child('callerId').val() === auth.uid))"
      }
    },
    "incomingCall": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.uid === $uid || ((!data.exists() || data.child('callerId').val() === auth.uid || data.child('createdAt').val() < now - 60000) && (!newData.exists() || newData.child('callerId').val() === auth.uid)))",
        ".validate": "!newData.exists() || (newData.hasChildren(['callId', 'callerId', 'callerName', 'createdAt']) && newData.child('createdAt').val() <= now)"
      }
    }
  }
}
